{{#if main}}
<div class="__renderbox-container">
    <!-- Render Title (shown above viewer when viewing render) -->
    <div class="__renderbox-title-bar">
        <h2 class="__renderbox-title"></h2>
    </div>

    <!-- IFC Viewer (hidden until render selected) -->
    <div class="__renderbox-viewer">
        <div class="__renderbox-grid-overlay"></div>
        <div class="__renderbox-download-group">
            <button class="__renderbox-viewer-download" title="Download IFC file">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
            </button>
        </div>
        <div class="__renderbox-element-panel hidden">
            <div class="__renderbox-panel-header">
                <span class="__renderbox-panel-type-badge"></span>
                <span class="__renderbox-panel-name"></span>
                <button class="__renderbox-panel-close" title="Close" aria-label="Close">&times;</button>
            </div>
            <div class="__renderbox-panel-body">
                <div class="__renderbox-panel-geometry __renderbox-panel-section"></div>
                <div class="__renderbox-panel-relationships __renderbox-panel-section"></div>
                <div class="__renderbox-panel-provenance __renderbox-panel-section"></div>
            </div>
        </div>
    </div>

    <!-- Main Content Area: Message + Chat -->
    <div class="__renderbox-content">
        <!-- Empty state logo (grayscale) -->
        <svg class="__renderbox-empty-icon" width="80" height="88" viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polyline points="40,205 40,22 112,75 112,205" stroke="currentColor" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"/>
            <polyline points="92,205 92,95 155,95 155,205" stroke="currentColor" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"/>
            <line x1="92" y1="128" x2="155" y2="205" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
            <line x1="15" y1="212" x2="182" y2="212" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
        </svg>
        <!-- Welcome Message (hidden by CSS) -->
        <div class="__renderbox-message">
            <p class="__renderbox-message-welcome">Welcome, <span class="__renderbox-user-name"></span></p>
        </div>
    </div>

    <!-- Upload/Processing Loading State (centered in container) -->
    <div class="__renderbox-upload-loading hidden">
        <div class="__renderbox-pipeline-status">
            <div class="__renderbox-pipeline-spinner"></div>
            <span class="__renderbox-loading-text">Processing</span>
            <span class="__renderbox-pipeline-elapsed"></span>
        </div>
    </div>

    <!-- Chat Footer (always visible) -->
    <div class="__renderbox-footer">
        <!-- File Preview (shown when files are staged) -->
        <div class="__renderbox-file-staging hidden">
            <div class="__renderbox-file-grid"></div>
        </div>

        <div class="__renderbox-chat">
            <div class="__renderbox-chat-input">
                <input
                    type="file"
                    multiple
                    id="__renderbox-file-input"
                    style="display: none"
                    class="__renderbox-file-input"
                />
                <label class="__renderbox-attach" title="Attach files" for="__renderbox-file-input">
                    <svg class="__renderbox-action-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.414a6 6 0 108.486 8.486L20.5 13"></path>
                    </svg>
                </label>
                <div
                    contenteditable="true"
                    placeholder="Describe the structure you want to generate..."
                    class="__renderbox-input __renderbox-description"
                    role="textbox"
                ></div>
                <div class="__renderbox-chat-actions">
                    <button class="__renderbox-send __renderbox-start" title="Start rendering">
                        <svg class="__renderbox-action-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{{/if}}
