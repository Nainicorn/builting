FROM continuumio/miniconda3:latest

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create conda environment with ifcopenshell and Python 3.11
RUN conda create -y -n lambda -c conda-forge python=3.11 ifcopenshell lark && conda clean -a -y

# Install Lambda runtime support and additional dependencies
RUN /opt/conda/envs/lambda/bin/pip install --no-cache-dir awslambdaric boto3 trimesh numpy lark-parser

# Set up Lambda task root
ENV LAMBDA_TASK_ROOT=/var/task
WORKDIR ${LAMBDA_TASK_ROOT}

# Copy application code
COPY lambda_function.py ${LAMBDA_TASK_ROOT}/lambda_function.py
COPY lambda_package/ ${LAMBDA_TASK_ROOT}/lambda_package/

# Use conda environment's Python
ENV PATH=/opt/conda/envs/lambda/bin:$PATH
ENV PYTHONPATH=${LAMBDA_TASK_ROOT}:/opt/conda/envs/lambda/lib/python3.11/site-packages

# Set the Lambda handler
ENTRYPOINT [ "/opt/conda/envs/lambda/bin/python", "-m", "awslambdaric" ]
CMD [ "lambda_function.handler" ]
